# Copy to .env and edit. Everything works with these defaults in MOCK mode.
DATABASE_URL=sqlite:///./quickiq.db
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
PUBLIC_BASE_URL=http://localhost:8000
CALLBACK_SECRET=dev-callback-secret
ADMIN_TOKEN=dev-admin-token

# mock = no Safaricom calls (default). sandbox = real Daraja sandbox calls.
MPESA_MODE=mock

# --- Only needed for MPESA_MODE=sandbox (developer.safaricom.co.ke > your app) ---
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=testapi
MPESA_INITIATOR_PASSWORD=
MPESA_CERT_PATH=./SandboxCertificate.cer

# --- Optional: LLM custom categories (any OpenAI-compatible API, e.g. Groq / DeepSeek) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
